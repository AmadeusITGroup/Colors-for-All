{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "colors-for-all": {
      "root": "",
      "sourceRoot": "src",
      "projectType": "application",
      "prefix": "cm",
      "schematics": {
        "@schematics/angular:component": {
          "styleext": "scss"
        }
      },
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:browser",
          "options": {
            "outputPath": "dist/colors-for-all",
            "index": "src/index.html",
            "main": "src/main.ts",
            "polyfills": "src/polyfills.ts",
            "tsConfig": "src/tsconfig.app.json",
            "assets": [
              "src/favicon.ico",
              "src/assets",
              {
                "glob": "LICENSE.md",
                "input": "node_modules/apca-w3",
                "output": "assets/apca-w3"
              }
            ],
            "styles": [
              "src/styles.scss"
            ],
            "scripts": [],
            "optimization": false,
            "sourceMap": true
          },
          "configurations": {
            "production": {
              "fileReplacements": [
                {
                  "replace": "src/environments/environment.ts",
                  "with": "src/environments/environment.prod.ts"
                }
              ],
              "baseHref": "https://AmadeusITGroup.github.io/Colors-for-All/",
              "optimization": true,
              "outputHashing": "all",
              "sourceMap": false,
              "namedChunks": false,
              "aot": true,
              "extractLicenses": true,
              "vendorChunk": false,
              "buildOptimizer": true
            }
          }
        },
        "serve": {
          "builder": "@angular-devkit/build-angular:dev-server",
          "options": {
            "browserTarget": "colors-for-all:build"
          },
          "configurations": {
            "production": {
              "browserTarget": "colors-for-all:build:production"
            }
          }
        },
        "extract-i18n": {
          "builder": "@angular-devkit/build-angular:extract-i18n",
          "options": {
            "browserTarget": "colors-for-all:build"
          }
        },
        "test": {
          "builder": "@angular-devkit/build-angular:karma",
          "configurations": {
            "contrast": {
              "main": "",
              "polyfills": ["zone.js", "zone.js/testing"],
              "tsConfig": "src/tsconfig.contrast-spec.json",
              "karmaConfig": "src/karma.contrast.conf.js",
              "include": ["src/app/core/services/color-matrix.service.spec.ts", "src/app/core/services/matrix-loading.service.spec.ts", "src/app/core/state/color-palette.state.spec.ts", "src/app/core/components/color-palette-save-modal/color-palette-save-modal.component.spec.ts", "src/app/core/services/color-palette.service.spec.ts", "src/app/color-palette/components/matrix-table/matrix-table.component.spec.ts", "src/app/color-palette/components/help/help.component.spec.ts", "src/app/core/components/navigation/navigation-download.spec.ts"],
              "watch": false,
              "browsers": "ChromeHeadless"
            }
          },
          "options": {
            "main": "src/test.ts",
            "polyfills": "src/polyfills.ts",
            "tsConfig": "src/tsconfig.spec.json",
            "karmaConfig": "src/karma.conf.js",
            "styles": [
              "src/styles.scss"
            ],
            "scripts": [],
            "assets": [
              "src/favicon.ico",
              "src/assets"
            ]
          }
        },
        "lint": {
          "builder": "@angular-devkit/build-angular:tslint",
          "options": {
            "tsConfig": [
              "src/tsconfig.app.json",
              "src/tsconfig.spec.json"
            ],
            "exclude": [
              "**/node_modules/**"
            ]
          }
        },
        "deploy": {
          "builder": "angular-cli-ghpages:deploy",
          "options": {
            "buildTarget": "colors-for-all:build:production"
          }
        }
      }
    },
    "colors-for-all-e2e": {
      "root": "e2e/",
      "projectType": "application",
      "architect": {
        "e2e": {
          "builder": "@angular-devkit/build-angular:protractor",
          "options": {
            "protractorConfig": "e2e/protractor.conf.js",
            "devServerTarget": "colors-for-all:serve"
          },
          "configurations": {
            "production": {
              "devServerTarget": "colors-for-all:serve:production"
            }
          }
        },
        "lint": {
          "builder": "@angular-devkit/build-angular:tslint",
          "options": {
            "tsConfig": "e2e/tsconfig.e2e.json",
            "exclude": [
              "**/node_modules/**"
            ]
          }
        }
      }
    }
  },
  "defaultProject": "colors-for-all",
  "cli": {
    "analytics": false
  }
}
